{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haxtheweb/haxcms-plugin-examples/schema/dashboard-contribution.schema.json",
  "title": "Dashboard contribution (registries/dashboard/*.yaml) - DRAFT",
  "description": "Declarative UI a plugin adds to the HAXcms dashboard (app-hax). The dashboard renders it with elements it already has (simple-icon-button-lite, simple-tooltip, simple-modal, accent-card, hax-element-demo, simple-icon-lite), so the plugin ships no front-end code. Data comes from the plugin's own operations through app-hax's API layer, which adds the credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "placement",
    "icon",
    "label",
    "action"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "placement": {
      "enum": [
        "topbar",
        "userMenu"
      ],
      "description": "topbar: an icon button in the top bar's right group, before the user menu. userMenu: an entry in the user menu."
    },
    "icon": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "description": "Accessible name and tooltip; translatable through the plugin's locale overlay."
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "dismissKey"
      ],
      "description": "A chip on the button while there is something undismissed. The dashboard keeps { seenVersion, dismissedVersion } in user scaffold long-term memory under dismissKey; the chip shows while dismissedVersion is missing or older than the field's value (dotted-number compare).",
      "properties": {
        "label": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "description": "Omit for a badge that shows until dismissed (a tour)."
        },
        "field": {
          "type": "string"
        },
        "dismissKey": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
        }
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "sections"
          ],
          "properties": {
            "kind": {
              "const": "modal"
            },
            "title": {
              "type": "string"
            },
            "filters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "from"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "from": {
                  "type": "string",
                  "description": "Dot path in the first section's response to a map of { id: { label, icon, color } } shown as filter chips."
                }
              }
            },
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "operation"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "May use {{field}} from the badge operation's response."
                  },
                  "operation": {
                    "type": "string"
                  },
                  "query": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "items": {
                    "type": "string",
                    "description": "Dot path to the array in the response; omit when the response is a single item."
                  },
                  "card": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "chip": {
                        "type": "string",
                        "description": "Dot path to a { label, icon, color } object, usually types[{{type}}]; rendered with label and icon, never color alone."
                      },
                      "visual": {
                        "type": "string",
                        "description": "Field holding { mode: element, tag } (rendered by hax-element-demo) or { mode: screenshot, url, alt } (url relative to the plugin's routes)."
                      },
                      "links": {
                        "type": "string"
                      },
                      "anchor": {
                        "type": "string",
                        "description": "Field used as the card id, so Merlin can open the modal on one entry."
                      }
                    }
                  }
                }
              }
            },
            "dismiss": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string"
                }
              },
              "description": "A footer button that records the badge value as dismissed and closes the modal. Closing without it records seen only."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "steps"
          ],
          "description": "A guided tour: the dashboard highlights each anchor in turn with the step's title and text. Progress is kept in user scaffold memory under the contribution's badge dismissKey, so a tour needs no backend.",
          "properties": {
            "kind": {
              "const": "tour"
            },
            "title": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "anchor",
                  "title",
                  "text"
                ],
                "properties": {
                  "anchor": {
                    "enum": [
                      "topbar",
                      "create-site",
                      "site-list",
                      "site-search",
                      "site-card",
                      "user-menu",
                      "merlin",
                      "plugins"
                    ],
                    "description": "Stable dashboard anchors app-hax promises to keep (data-hax-anchor attributes). Plugins never target other parts of the dashboard."
                  },
                  "title": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
