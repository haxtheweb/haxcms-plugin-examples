{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haxtheweb/haxcms-plugin-examples/schema/plugin.schema.json",
  "title": "HAXcms plugin manifest (plugin.yaml)",
  "description": "Draft. Unknown keys are rejected. Keys described as reserved are validated but have no behavior yet. Decisions: https://github.com/haxtheweb/issues/issues/3176",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "id",
    "uuid",
    "title",
    "description",
    "version"
  ],
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "description": "Full semver of the spec targeted; the loader refuses a newer major (pre-1.0: a newer minor)."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "Folder name; kebab-case; unique within a tier."
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "description": "Required. Generated once by the CLI (hax plugin create) and never changed; stable identity across renames and forks."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "description": "One category for the dashboard and registry. Known values in categories.json; use \"other\" when none fits. Unknown values warn (open vocabulary). Required by the audit."
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Up to three free-form author tags for search and filtering (the one category is separate). Derived tags (derived-tags.json) are computed from the manifest, always shown, do not count toward the three, and cannot be set or removed here.",
      "maxItems": 3
    },
    "siteTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Kinds of site this plugin suits (course, blog, portfolio, documentation, \u2026; open vocabulary). Reserved for recommendations: telling owners of a matching site that the plugin exists, locally and later from remote registries."
    },
    "icon": {
      "type": "string",
      "description": "An icon name from a HAX iconset (e.g. \"icons:lightbulb-outline\") or a path to an SVG/PNG in the plugin. See https://github.com/haxtheweb/issues/issues/3173. Required by the audit."
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "src",
          "alt"
        ],
        "properties": {
          "src": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          }
        }
      },
      "description": "Images in the plugin folder for the dashboard and registry. Optional."
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readme": {
          "type": "string",
          "default": "README.md",
          "description": "Path to the plugin README. Required by the audit."
        },
        "help": {
          "type": "string",
          "format": "uri",
          "description": "Optional external help page the dashboard links to."
        },
        "agents": {
          "type": "string",
          "default": "AGENTS.md",
          "description": "Path to the plugin's AGENTS.md: everything an agent needs to understand, extend and diagnose the plugin. Required by the audit."
        },
        "prompts": {
          "type": "string",
          "description": "Path to a prompts file (schema/prompts.schema.json): copyable diagnostic and how-to prompts shown on the plugin's screen."
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "Agent skills shipped in skills/<name>/SKILL.md (agentskills.io format). audience site: published into a site's .well-known/agent-skills index while the plugin is enabled for it. audience system: published into the system's front-end .well-known/agent-skills so agents can discover the deployment's capabilities. audience developer: read from the plugin package by tools and agents working on the plugin or the system; never published.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "audience"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Folder name under skills/; must start with the plugin id and a dash."
          },
          "audience": {
            "enum": [
              "site",
              "system",
              "developer"
            ]
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "enum": [
        "plugin",
        "pack"
      ],
      "default": "plugin",
      "description": "pack = declarative only, no backend code."
    },
    "group": {
      "type": "string"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "haxcms": {
          "type": "string",
          "description": "Compatible platform semver range."
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pluginRef"
      }
    },
    "suggests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pluginRef"
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "description": "Plugins known not to work alongside this one. Enabling both is allowed with a warning on the dashboard, CLI and log.",
      "items": {
        "$ref": "#/$defs/pluginRef"
      }
    },
    "testDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pluginRef"
      }
    },
    "tests": {
      "type": "string",
      "default": "tests",
      "description": "Folder with the plugin's tests: cases/*.yaml (test-case.schema.json) plus runtime tests (nodejs/, php/). Required by the audit unless untested is true."
    },
    "untested": {
      "type": "boolean",
      "default": false,
      "description": "Explicitly ships without tests. Shown as the derived tag 'untested' on the plugin screen and in listings."
    },
    "core": {
      "type": "boolean",
      "default": false,
      "description": "Ships with HAXcms. Core plugins that are not required are off until someone enables them (for example google-analytics)."
    },
    "required": {
      "type": "boolean",
      "default": false,
      "description": "Core only. Always enabled and cannot be disabled. There is no separate default-enabled flag: required core plugins are on, everything else is off until enabled."
    },
    "hidden": {
      "type": "boolean"
    },
    "lifecycle": {
      "enum": [
        "stable",
        "experimental",
        "deprecated",
        "obsolete"
      ],
      "default": "stable"
    },
    "lifecycleLink": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "redistribution": {
      "enum": [
        "allowed",
        "restricted"
      ],
      "default": "allowed"
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "nodejs",
          "php"
        ]
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodejs": {
          "type": "string"
        },
        "php": {
          "type": "string"
        }
      }
    },
    "openapi": {
      "type": "string"
    },
    "entities": {
      "type": "string"
    },
    "contracts": {
      "type": "string"
    },
    "datastores": {
      "type": "string"
    },
    "settings": {
      "type": "string"
    },
    "admin": {
      "type": "string"
    },
    "implements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z]*(\\.[a-z][a-zA-Z]*)+$",
            "description": "Open vocabulary. Known names are listed in hooks.json; the loader warns on unknown but well-formed names."
          },
          "priority": {
            "type": "integer",
            "default": 0
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detached": {
            "type": "boolean",
            "default": false,
            "description": "After hooks only: run after the operation's response is sent (Node: not awaited; PHP: after flush or queue). Gets the longer detached timeout."
          },
          "timeout": {
            "type": "integer",
            "minimum": 100,
            "maximum": 30000,
            "description": "Milliseconds. Overrides the default for this hook (before hooks default to 5000)."
          },
          "config": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "config.* hooks only: which plugins' config this subscription sees. Omitted means the plugin's own config; plugin ids for specific others; [\"*\"] for every config read and write (uncommon: backups, auditing)."
          }
        }
      }
    },
    "hookDefinitions": {
      "type": "string",
      "description": "Path to hooks this plugin defines and fires (hook-contracts.schema.json). Names start with the plugin id; aliases may point at core hooks or the plugin's own."
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "description": "Generated by `hax plugin build`.",
      "properties": {
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skeletons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merlin": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "appstore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "description": "Generated by `hax plugin build`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hash",
          "size",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256-[A-Za-z0-9+/=_-]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "type": "string"
          },
          "redistribution": {
            "enum": [
              "allowed",
              "restricted"
            ]
          }
        }
      }
    },
    "tagPrefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*-$"
    },
    "staticCapable": {
      "type": "boolean",
      "description": "Whether the plugin works on a statically published site with no backend. false is shown as a 'needs a server' tag on the plugin wherever it is listed, and the publish step warns, because it infringes the portable-static pillar. The validator warns when a plugin with routes does not set this to false."
    },
    "egress": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "hostname"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z]*:[a-z][a-zA-Z]*$",
        "description": "Open vocabulary (area:action). Starting vocabulary is documented in spec/08; the loader warns on unknown names."
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tracking": {
          "type": "boolean"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cookies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "hostname"
          }
        },
        "requiresConsent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "managedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schedules": {
      "type": "array",
      "description": "Recurring jobs. Each runs the named handler exported by the plugin's backend entry, wrapped by schedule.before.run / schedule.after.run.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cron",
          "handler"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "cron": {
            "type": "string",
            "description": "Five-field cron expression, evaluated in the system time zone."
          },
          "handler": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
            "description": "Exported function (Node) / public method (PHP) name."
          },
          "scope": {
            "enum": [
              "system",
              "site"
            ],
            "default": "system",
            "description": "site runs once per site where the plugin is enabled."
          },
          "timeout": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 600000
          }
        }
      }
    },
    "legacy": {
      "type": "object",
      "description": "Reserved: aliases for extracted core routes, tags and registry paths."
    },
    "packaged": {
      "type": "object",
      "description": "Reserved: written by `hax plugin pack`."
    },
    "integrity": {
      "type": "object",
      "description": "Reserved: written by `hax plugin pack`."
    },
    "exec": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "description": "Command names the plugin may run as child processes. Requires the exec:run capability; audited by static scan."
    }
  },
  "$defs": {
    "pluginRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(@.+)?$",
      "description": "Plugin id, optionally with a semver range; a bare id means any version."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "required"
        ],
        "properties": {
          "required": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "core"
        ],
        "properties": {
          "core": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "lifecycle"
        ],
        "properties": {
          "lifecycle": {
            "enum": [
              "deprecated",
              "obsolete"
            ]
          }
        }
      },
      "then": {
        "required": [
          "lifecycleLink"
        ]
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "pack"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "entry"
              ]
            },
            {
              "required": [
                "runtimes"
              ]
            },
            {
              "required": [
                "hooks"
              ]
            },
            {
              "required": [
                "openapi"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "kind"
              ]
            }
          },
          {
            "properties": {
              "kind": {
                "const": "plugin"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "runtimes",
          "entry"
        ]
      }
    },
    {
      "if": {
        "required": [
          "required"
        ],
        "properties": {
          "required": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "runtimes": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "privacy"
        ],
        "properties": {
          "privacy": {
            "required": [
              "tracking"
            ],
            "properties": {
              "tracking": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "privacy": {
            "required": [
              "categories",
              "requiresConsent"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "exec"
        ]
      },
      "then": {
        "required": [
          "capabilities"
        ],
        "properties": {
          "capabilities": {
            "contains": {
              "const": "exec:run"
            }
          }
        }
      }
    }
  ]
}
